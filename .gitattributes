# Normalize line endings: store as LF in the repo, check out native on Windows.
# Keeps diffs clean across the Windows dev machine and Cloudflare's Linux build.
* text=auto eol=lf

# Treat these as binary (never touch line endings / never diff as text).
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
