---
import Layout from "../layouts/Layout.astro";
import LeagueResults from "../components/LeagueResults.astro";
import standings from "../data/standings-men.json";
import fixtures from "../data/fixtures-men.json";

const compLabel = standings.competition.replace(/\s*-\s*/, " – ");
---

<Layout
  title="Πρωτάθλημα"
  description={`Αποτελέσματα και βαθμολογία του Ατρόμητου Πλαγιαρίου — ${compLabel}.`}
>
  <LeagueResults eyebrow="Αποτελέσματα" title="Πρωτάθλημα" standings={standings} fixtures={fixtures} />
</Layout>
