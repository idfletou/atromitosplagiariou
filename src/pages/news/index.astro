---
import Layout from "../../layouts/Layout.astro";
import NewsCard from "../../components/NewsCard.astro";
import { getAllNews } from "../../lib/news";

const posts = await getAllNews();
---

<Layout
  title="Νέα"
  description="Όλα τα νέα, οι αγώνες και οι ανακοινώσεις του Ατρόμητου Πλαγιαρίου F.C."
>
  <section class="bg-brand-800 text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-200">Ενημέρωση</p>
      <h1 class="mt-2 text-3xl font-extrabold uppercase sm:text-4xl">Νέα & Ανακοινώσεις</h1>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-14">
    {
      posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <NewsCard post={post} />
          ))}
        </div>
      ) : (
        <p class="rounded-lg bg-brand-50 p-6 text-brand-800">
          Δεν υπάρχουν ακόμη δημοσιεύσεις. Μείνετε συντονισμένοι!
        </p>
      )
    }
  </div>
</Layout>
