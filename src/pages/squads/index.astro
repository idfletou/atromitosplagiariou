---
import Layout from "../../layouts/Layout.astro";

const squads = [
  {
    name: "Ανδρική Ομάδα",
    description: "Το ρόστερ και το τεχνικό τιμ της πρώτης ομάδας",
    href: "/squads/men",
    tone: "primary", // navy
    ready: true,
  },
  {
    name: "Ακαδημίες",
    description: "Οι ομάδες υποδομής και οι προπονητές τους",
    href: "/squads/academy",
    tone: "secondary", // lighter blue
    ready: true,
  },
];
---

<Layout
  title="Ομάδες"
  description="Οι ομάδες του Ατρόμητου Πλαγιαρίου — ανδρική ομάδα και τμήματα υποδομής."
>
  <section class="bg-brand-800 text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-200">Ο Σύλλογος</p>
      <h1 class="mt-2 text-3xl font-extrabold uppercase sm:text-4xl">Οι Ομάδες μας</h1>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        squads.map((squad) =>
          squad.ready ? (
            <a
              href={squad.href}
              class:list={[
                "group flex items-center justify-between gap-4 overflow-hidden rounded-xl p-6 text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg sm:p-7",
                squad.tone === "primary" ? "bg-brand-800" : "bg-brand-600",
              ]}
            >
              <div>
                <h2 class="font-display text-xl font-extrabold uppercase tracking-tight sm:text-2xl">
                  {squad.name}
                </h2>
                <p
                  class:list={[
                    "mt-1 text-sm",
                    squad.tone === "primary" ? "text-brand-100/80" : "text-white/80",
                  ]}
                >
                  {squad.description}
                </p>
              </div>
              <span class="shrink-0 text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">
                →
              </span>
            </a>
          ) : (
            <div class="flex items-center justify-between gap-4 rounded-xl border border-dashed border-brand-200 bg-brand-50 p-6 sm:p-7">
              <div>
                <h2 class="font-display text-xl font-extrabold uppercase tracking-tight text-brand-800">
                  {squad.name}
                </h2>
                <p class="mt-1 text-sm text-brand-800/60">{squad.description}</p>
              </div>
              <span class="shrink-0 rounded-full bg-brand-200 px-3 py-1 text-xs font-semibold text-brand-800">
                Σύντομα
              </span>
            </div>
          ),
        )
      }
    </div>
  </div>
</Layout>
