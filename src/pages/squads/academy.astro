---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TeamPhoto from "../../components/TeamPhoto.astro";
import Coaches from "../../components/Coaches.astro";
import { academyGroups } from "../../data/academy";

const title = "Ακαδημίες";
const subtitle = "Τα τμήματα υποδομής του συλλόγου";
---

<Layout title={title} description={`${title} — ${subtitle}.`}>
  <section class="bg-brand-800 text-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-200">Ομάδες</p>
      <h1 class="mt-2 text-3xl font-extrabold uppercase sm:text-4xl">{title}</h1>
      <p class="mt-2 text-brand-100/80">{subtitle}</p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl space-y-16 px-4 py-12">
    {
      academyGroups.map((group) => (
        <section>
          <SectionHeading title={group.title} />
          <div class="space-y-6">
            <TeamPhoto src={group.photo} alt={`Ομαδική φωτογραφία — ${group.title}`} />
            <Coaches staff={group.coaches} title="Προπονητικό Τιμ" />
          </div>
        </section>
      ))
    }
  </div>
</Layout>
