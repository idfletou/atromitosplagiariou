---
import { site, nav, isNavParent } from "../data/site";
import Sponsors from "./Sponsors.astro";
import StadiumMap from "./StadiumMap.astro";
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, url]) => url);

// Flatten the nav (expand dropdown parents into their child links).
const footerLinks = nav.flatMap((item) =>
  isNavParent(item) ? item.children : [item],
);
---

<footer>
  <!-- Sponsors band (light) -->
  <Sponsors />

  <!-- Main footer -->
  <div class="bg-brand-900 text-brand-100">
    <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-x-8 gap-y-10 text-center md:grid-cols-3 md:text-left">
      <!-- Crest + contact -->
      <div>
        <img
          src="/crest.png"
          alt="Ατρόμητος Πλαγιαρίου F.C."
          width="112"
          height="112"
          class="mx-auto h-24 w-24 sm:h-28 sm:w-28 md:mx-0"
        />
        <div class="mt-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-300">
            Επικοινωνία
          </p>
          <ul class="mt-3 space-y-2 text-sm">
            {
              site.phone && (
                <li>
                  <a
                    href={`tel:${site.phone.replace(/\s+/g, "")}`}
                    class="hover:text-white hover:underline"
                  >
                    {site.phone}
                  </a>
                </li>
              )
            }
            {
              site.email && (
                <li>
                  <a href={`mailto:${site.email}`} class="hover:text-white hover:underline">
                    {site.email}
                  </a>
                </li>
              )
            }
            {
              socials.length > 0 && (
                <li class="flex justify-center gap-4 pt-1 md:justify-start">
                  {socials.map(([name, url]) => (
                    <a href={url} class="capitalize hover:text-white hover:underline">
                      {name}
                    </a>
                  ))}
                </li>
              )
            }
          </ul>
        </div>
      </div>

      <!-- Nav (hidden on mobile — the sticky hamburger menu covers it) -->
      <nav aria-label="Υποσέλιδο" class="hidden md:block">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-300">
          Πλοήγηση
        </p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            footerLinks.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Stadium map -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-300">
          Το γήπεδό μας
        </p>
        <div class="mt-3">
          <StadiumMap />
        </div>
      </div>
    </div>

    <div
      class="mt-10 border-t border-brand-800 pt-6 text-xs text-brand-300 flex flex-col gap-1 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <p>© {year} {site.name}</p>
      <p>Με επιφύλαξη κάθε δικαιώματος.</p>
    </div>
    </div>
  </div>
</footer>
