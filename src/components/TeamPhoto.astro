---
// Wide team-photo banner. Pass `src` to show a real photo; leave it empty to
// render a labelled placeholder (handy until the real photo is ready).
// Put images in public/team/ and pass e.g. src="/team/men-2026.jpg".
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}
const { src, alt = "", caption } = Astro.props;
---

{
  src ? (
    <figure class="overflow-hidden rounded-xl border border-brand-100 shadow-sm">
      <img src={src} alt={alt} class="aspect-[16/9] w-full object-cover sm:aspect-[21/9]" />
      {caption && (
        <figcaption class="bg-brand-50 px-4 py-2 text-center text-sm text-brand-800/70">
          {caption}
        </figcaption>
      )}
    </figure>
  ) : (
    <div class="flex aspect-[16/9] w-full flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-brand-300 bg-brand-50 text-brand-400 sm:aspect-[21/9]">
      <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <circle cx="8.5" cy="9.5" r="1.5" />
        <path stroke-linecap="round" stroke-linejoin="round" d="m4 18 5-5 3 3 4-4 4 4" />
      </svg>
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-500">Ομαδική φωτογραφία</p>
        <p class="text-xs text-brand-400">Προσθέστε την εικόνα της ομάδας εδώ</p>
      </div>
    </div>
  )
}
