---
interface Props {
  name: string;
  number?: number;
  position: "GK" | "DEF" | "MID" | "FWD";
  photo?: string;
  birthDate?: string; // ISO YYYY-MM-DD
  height?: number;
}
const { name, number, position, photo, birthDate, height } = Astro.props;

// "1996-11-12" -> "12/11/1996"
function formatDob(iso: string): string {
  const [y, m, d] = iso.split("-");
  return `${d}/${m}/${y}`;
}

// 189 (cm) -> "1,89 μ."
function formatHeight(cm: number): string {
  return `${(cm / 100).toFixed(2).replace(".", ",")} μ.`;
}

const posFull: Record<Props["position"], string> = {
  GK: "Τερματοφύλακας",
  DEF: "Αμυντικός",
  MID: "Μέσος",
  FWD: "Επιθετικός",
};

const parts = name.trim().split(" ");
const lastName = parts.length > 1 ? parts.slice(1).join(" ") : parts[0];
const firstName = parts.length > 1 ? parts[0] : "";

// Generic, non-judgemental info rows for the back.
const facts = [
  { label: "Θέση", value: posFull[position] },
  number != null ? { label: "Αριθμός", value: `#${number}` } : null,
  birthDate ? { label: "Γεννήθηκε", value: formatDob(birthDate) } : null,
  height ? { label: "Ύψος", value: formatHeight(height) } : null,
].filter((f): f is { label: string; value: string } => f !== null);

// Flip is worthwhile only when there's extra info beyond position/number.
const hasBack = Boolean(birthDate || height);
---

<div
  class:list={[
    "flip-card group relative aspect-[3/4] w-full rounded-xl shadow-sm transition-shadow hover:shadow-lg",
    hasBack && "is-flippable cursor-pointer",
  ]}
  tabindex={hasBack ? 0 : undefined}
  role={hasBack ? "button" : undefined}
  aria-label={hasBack ? `${name} — περισσότερες πληροφορίες` : undefined}
>
  <div class="flip-inner h-full w-full">
    <!-- ============ FRONT (portrait) ============ -->
    <div class="flip-face flip-front overflow-hidden rounded-xl border border-brand-100 bg-white">
      <div class="relative h-full w-full bg-gradient-to-b from-brand-500 to-brand-800">
        {
          photo ? (
            <img src={photo} alt={name} loading="lazy" class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <img src="/crest.png" alt="" width="96" height="96" class="h-24 w-24 opacity-20" />
            </div>
          )
        }

        <!-- Kit number (top-right) -->
        {
          number != null && (
            <span class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-brand-900/70 text-sm font-extrabold leading-none text-white backdrop-blur">
              {number}
            </span>
          )
        }

        <!-- Name plate -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-950/90 to-transparent p-3 pt-6">
          {firstName && <p class="truncate text-[11px] text-brand-100/80">{firstName}</p>}
          <p class="font-display text-sm font-bold uppercase leading-tight text-white [overflow-wrap:anywhere] sm:text-base" title={name}>
            {lastName}
          </p>
        </div>
      </div>
    </div>

    <!-- ============ BACK (info list) ============ -->
    {
      hasBack && (
        <div class="flip-face flip-back overflow-hidden rounded-xl border border-brand-700 text-white">
          {/* Texture layers */}
          <div class="absolute inset-0 bg-gradient-to-br from-brand-700 to-brand-950" />
          <div
            class="absolute inset-0"
            style="background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 10px);"
          />
          <img
            src="/crest.png"
            alt=""
            class="pointer-events-none absolute -bottom-6 -right-6 w-40 opacity-[0.07]"
          />

          {/* Content */}
          <div class="relative flex h-full flex-col p-3">
            <div class="shrink-0">
              {firstName && <p class="truncate text-[11px] text-brand-200">{firstName}</p>}
              <p class="font-display text-sm font-extrabold uppercase leading-none [overflow-wrap:anywhere] sm:text-base" title={name}>
                {lastName}
              </p>
            </div>

            <dl class="mt-3 flex flex-1 flex-col">
              {facts.map((f) => (
                <div class="flex flex-1 items-center justify-between gap-1.5 border-t border-white/10 first:border-t-0">
                  <dt class="shrink-0 whitespace-nowrap text-[9px] text-brand-200">{f.label}</dt>
                  <dd class="truncate text-right text-[11px] font-bold leading-tight">{f.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .flip-card {
    perspective: 1000px;
  }
  .flip-inner {
    position: relative;
    transition: transform 0.5s;
    transform-style: preserve-3d;
  }
  .flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-back {
    transform: rotateY(180deg);
  }
  /* Tap / keyboard flip (all devices) */
  .flip-card.is-flipped .flip-inner {
    transform: rotateY(180deg);
  }
  /* Hover / focus flip (pointer devices only) */
  @media (hover: hover) and (pointer: fine) {
    .is-flippable:hover .flip-inner,
    .is-flippable:focus-within .flip-inner {
      transform: rotateY(180deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-inner {
      transition: none;
    }
  }
</style>

<script>
  // On touch devices, tap toggles the flip. On pointer devices the CSS
  // :hover handles it, so we skip click there to avoid it "sticking".
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  document.querySelectorAll<HTMLElement>(".flip-card.is-flippable").forEach((card) => {
    if (!canHover) {
      card.addEventListener("click", () => card.classList.toggle("is-flipped"));
    }
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        card.classList.toggle("is-flipped");
      }
    });
  });
</script>
