---
import { sponsors } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

{
  sponsors.length > 0 && (
    <section class="border-t border-brand-100 bg-white" aria-label="Χορηγοί & υποστηρικτές">
      <div class="mx-auto max-w-6xl px-4 py-14">
        <SectionHeading title="Χορηγοί & Υποστηρικτές" />
        <ul class="flex flex-wrap items-center justify-start gap-x-8 gap-y-6 sm:gap-x-12">
          {sponsors.map((s) => {
            const logo = s.logo ? (
              <img
                src={s.logo}
                alt={s.name}
                loading="lazy"
                class="h-9 w-auto max-w-[150px] object-contain opacity-70 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 sm:h-11"
              />
            ) : (
              <span class="flex h-11 min-w-[130px] items-center justify-center rounded-lg border border-dashed border-brand-200 px-4 text-sm font-semibold text-brand-400">
                {s.name}
              </span>
            );
            return (
              <li>
                {s.url ? (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener nofollow"
                    title={s.name}
                    class="block"
                  >
                    {logo}
                  </a>
                ) : (
                  logo
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
